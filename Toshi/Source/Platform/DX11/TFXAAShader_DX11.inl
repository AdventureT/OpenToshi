		"\t\t#define FxaaTexAlpha4(t, p) textureGather(t, p, 3)\n"
		"\t\t#define FxaaTexOffAlpha4(t, p, o) textureGatherOffset(t, p, o, 3)\n"
		"\t\t#define FxaaTexGreen4(t, p) textureGather(t, p, 1)\n"
